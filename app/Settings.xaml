<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="設定" Width="720" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F3F6FA" FontFamily="Yu Gothic UI" FontSize="14" Foreground="#243448">
  <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="MinHeight" Value="36"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="8"/></Style></Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="生成結果の保存先" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <DockPanel Grid.Row="1"><Button x:Name="BrowseOutput" Content="参照…" DockPanel.Dock="Right"/><TextBox x:Name="OutputDirectory"/></DockPanel>
    <TextBlock Grid.Row="2" Text="Codexのパス（CLIのcodex.exe）" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <DockPanel Grid.Row="3"><Button x:Name="BrowseCodex" Content="参照…" DockPanel.Dock="Right"/><Button x:Name="DetectCodex" Content="自動検出" DockPanel.Dock="Right"/><TextBox x:Name="CodexPath"/></DockPanel>
    <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="ChatGPTでログイン済みのCodex CLIを使用します。デスクトップ版の起動用exeとは異なります。" TextWrapping="Wrap" Foreground="#64748B"/><TextBlock x:Name="SettingsError" TextWrapping="Wrap" Foreground="#B42318" Margin="0,12,0,0"/></StackPanel>
    <DockPanel Grid.Row="5"><Button x:Name="ResetSettings" Content="設定を初期化" DockPanel.Dock="Left" ToolTip="保存先とCodexの設定を初期値に戻し、アプリを終了します。"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CloseSettings" Content="キャンセル" IsCancel="True"/><Button x:Name="SaveSettings" Content="保存" Background="#087F78" Foreground="White" IsDefault="True"/></StackPanel></DockPanel>
  </Grid>
</Window>
