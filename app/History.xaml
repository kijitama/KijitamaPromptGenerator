<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><TextBlock x:Name="CountLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#64748B"/><TextBlock x:Name="Heading" FontSize="24" Foreground="#087F78"/></DockPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,12">
      <Label Content="キーワード検索" Target="{Binding ElementName=Keyword}" VerticalAlignment="Center"/>
      <Button x:Name="ClearKeyword" Content="クリア" DockPanel.Dock="Right" Margin="8,0,0,0" IsEnabled="False"/>
      <TextBox x:Name="Keyword" VerticalContentAlignment="Center" ToolTip="スペースで区切ると、すべての語を含む結果を表示します。"/>
    </DockPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Records" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="#DCE3EA">
        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="6,5">
          <Image Width="60" Height="58" Margin="0,0,8,0" Stretch="Uniform" Source="{Binding Thumbnail}" Visibility="{Binding ThumbVisibility}" DockPanel.Dock="Left"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Stamp}" FontSize="12" Foreground="#64748B"/><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
        </DockPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" Background="White" Padding="14" BorderBrush="#DCE3EA" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition x:Name="ImageRow" Height="0"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Image x:Name="Preview" Stretch="Uniform" Margin="0,0,0,10"/>
          <TextBox Grid.Row="1" x:Name="Body" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal"><Button x:Name="CopyText" Content="プロンプトをコピー" Padding="14,7" IsEnabled="False"/><TextBlock x:Name="CopyNotice" VerticalAlignment="Center" Foreground="#087F78"/></StackPanel>
    </DockPanel>
  </Grid>
</UserControl>
