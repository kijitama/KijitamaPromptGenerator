<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
  <ScrollViewer.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,14,0,4"/></Style>
  </ScrollViewer.Resources>
  <StackPanel Margin="0,0,16,8">
    <TextBlock Style="{StaticResource SectionTitle}" Text="Kijitama Prompt Generator"/>
    <TextBlock>公式サイト　<Hyperlink NavigateUri="https://note.com/kijitama">https://note.com/kijitama</Hyperlink></TextBlock>
    <TextBlock Text="本ツール独自のコード（起動用exe、PowerShellスクリプト、画面定義）はMIT Licenseで配布します。外部ソフトウェアには、以下に掲載する各ライセンスが適用されます。"/>
    <Expander Header="本ツールのMIT License原文"><TextBox x:Name="ProjectLicense" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"/></Expander>

    <TextBlock Style="{StaticResource SectionTitle}" Text="PowerShell 7"/>
    <TextBlock Text="スクリプトの実行に使用します。MIT License。Copyright (c) Microsoft Corporation."/>
    <TextBlock><Hyperlink NavigateUri="https://github.com/PowerShell/PowerShell/blob/master/LICENSE.txt">ライセンス原文</Hyperlink>　<Hyperlink NavigateUri="https://github.com/PowerShell/PowerShell/blob/master/ThirdPartyNotices.txt">第三者ソフトウェアの通知</Hyperlink></TextBlock>
    <Expander Header="実行中のPowerShellに付属するライセンス原文"><TextBox x:Name="LocalLicense" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></Expander>

    <TextBlock Style="{StaticResource SectionTitle}" Text="OpenAI Codex CLI"/>
    <TextBlock Text="画像とプロンプトの生成に使用します。Codex CLIの公開ソースはApache License, Version 2.0です。Copyright 2025 OpenAI."/>
    <TextBlock Text="CodexのNOTICEには、Ratatui由来のコード（MIT License）、Florian Dehau（2016–2022）、The Ratatui Developers（2023–2025）の著作権表示があります。"/>
    <TextBlock><Hyperlink NavigateUri="https://github.com/openai/codex/blob/main/LICENSE">ライセンス原文</Hyperlink>　<Hyperlink NavigateUri="https://github.com/openai/codex/blob/main/NOTICE">著作権・第三者通知（NOTICE）</Hyperlink></TextBlock>

    <TextBlock Style="{StaticResource SectionTitle}" Text=".NET・WPF・Windows Forms"/>
    <TextBlock Text="PowerShellの実行基盤、画面表示、フォルダー選択に使用します。WPFとWindows Formsの公開ソースはMIT Licenseです。Copyright (c) .NET Foundation and Contributors. インストール版の条件と第三者通知は配布元の案内をご確認ください。"/>
    <TextBlock><Hyperlink NavigateUri="https://github.com/dotnet/core/blob/main/license-information.md">.NETのライセンス情報</Hyperlink>　<Hyperlink NavigateUri="https://github.com/dotnet/wpf/blob/main/LICENSE.TXT">WPFの原文</Hyperlink>　<Hyperlink NavigateUri="https://github.com/dotnet/winforms/blob/main/LICENSE.TXT">Windows Formsの原文</Hyperlink></TextBlock>

    <TextBlock Style="{StaticResource SectionTitle}" Text="Microsoft .NET Framework"/>
    <TextBlock Text="起動用exeはWindows上の.NET Frameworkを利用します。該当製品の利用条件は、Windowsまたは.NET Frameworkのインストール時に提示されるMicrosoftのライセンス条項をご確認ください。"/>
    <TextBlock><Hyperlink NavigateUri="https://www.microsoft.com/useterms">Microsoftの製品別ライセンス条項</Hyperlink></TextBlock>
  </StackPanel>
</ScrollViewer>
